# Copy to .env. Never commit real keys.
DATA_DIR=./runtime
DATABASE_URL=sqlite:///./runtime/ledgerlens.sqlite
TASK_MODE=local
# Optional isolated OCR worker (disabled when paths are absent). No auto-download.
# OCR_PYTHON=./.local/ocr-env/Scripts/python.exe
# OCR_MODELS_DIR=./.local/ocr-models
OCR_TIMEOUT_SECONDS=180
# Local JSON OpenTelemetry spans only; no network exporter or model/document content.
TELEMETRY_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MAX_UPLOAD_BYTES=20971520
PROCESS_DATASETS_DIR=./.local/bpi2019/process-events
ANNUAL_REPORTS_DIR=./.local/annual-reports
STATEMENT_DATASETS_DIR=./.local/annual-reports/statement-snapshots
